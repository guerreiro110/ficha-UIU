    </div>

    <div class="doc-header">
        <div class="uiu-logo">
            <span class="seal">Departamento de Justiça dos E.U.A.</span>
            <span class="org">Federal Bureau of Investigation<br>Unidade de Incidentes Incomuns</span>
            <span class="division">// Divisão de Contenção e Campo</span>
        </div>
        <div class="doc-id-block">
            <div class="doc-num">ARQUIVO Nº UIU-PERS-0047-ALFA</div>
            <div class="doc-num">EMITIDO: <span class="redacted-inline" style="background:#2a2d32;color:#2a2d32;padding:0 30px">██/██/████</span></div>
            <div class="doc-num" style="margin-top:8px">REVISÃO: 7ª</div>
            <div class="clearance" style="margin-top:10px">RESTRITO — NÍVEL 4</div>
        </div>
    </div>

    <div class="stamp-wrapper">
        <div class="stamp">RESTRITO</div>
    </div>

    <div class="subject-block">
        <div class="subject-label">// Arquivo de Pessoal — Sujeito</div>
        <div class="subject-name">FELIPE DE OLIVEIRA</div>
        <div class="subject-alias">Codinome operacional: "THE LAW" <span class="cursor"></span></div>

        <div class="meta-grid">
            <div class="meta-cell">
                <div class="meta-key">Idade</div>
                <div class="meta-val">36</div>
            </div>
            <div class="meta-cell">
                <div class="meta-key">Sexo</div>
