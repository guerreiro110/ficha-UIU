            </div>
            <div class="meta-cell">
                <div class="meta-key">Nacionalidade</div>
                <div class="meta-val">Estadunidense</div>
            </div>
            <div class="meta-cell">
                <div class="meta-key">Espécie</div>
                <div class="meta-val">Humano [verificado]</div>
            </div>
            <div class="meta-cell">
                <div class="meta-key">Sexualidade</div>
                <div class="meta-val">Heterossexual</div>
            </div>
            <div class="meta-cell">
                <div class="meta-key">Data de nasc.</div>
                <div class="meta-val"><span class="redacted-inline">arquivo não encontrado</span></div>
            </div>
            <div class="meta-cell">
                <div class="meta-key">Local de nasc.</div>
                <div class="meta-val"><span class="redacted-inline">arquivo não encontrado</span></div>
            </div>
